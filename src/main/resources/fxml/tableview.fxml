<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.TableViewController">
   <center>
      <TableView fx:id="treeTableView" prefHeight="200.0" prefWidth="518.0" style="-fx-text-background-color: black;" BorderPane.alignment="CENTER" />
   </center>
   <left>
      <VBox prefHeight="400.0" prefWidth="62.0" styleClass="sideBar">
         <Button fx:id="backButton" onMouseClicked="#onBackClicked" styleClass="sideBar-button-selected" text="Back" />
         <Button mnemonicParsing="false" onAction="#onFilterClicked" text="Filter" />
         <GridPane fx:id="filterList" prefHeight="219.0" prefWidth="122.0">
            <columnConstraints>
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints maxHeight="203.2000244140625" minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
               <RowConstraints maxHeight="203.2000244140625" minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
               <RowConstraints maxHeight="203.2000244140625" minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
               <RowConstraints maxHeight="203.2000244140625" minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
               <RowConstraints maxHeight="203.2000244140625" minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
               <CheckBox mnemonicParsing="false" onAction="#appleFilterChecked" text="Apple" />
               <CheckBox mnemonicParsing="false" onAction="#pearFilterChecked" text="Pear" GridPane.rowIndex="1" />
               <CheckBox mnemonicParsing="false" onAction="#cherryFilterChecked" text="Cherry" GridPane.rowIndex="2" />
               <CheckBox mnemonicParsing="false" onAction="#peachFilterChecked" text="Peach" GridPane.rowIndex="3" />
               <CheckBox mnemonicParsing="false" onAction="#apricotFilterChecked" text="Apricot" GridPane.rowIndex="4" />
            </children>
         </GridPane>
      </VBox>
   </left>
</BorderPane>
