<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.MapController">
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <WebView fx:id="webView" maxHeight="Infinity" maxWidth="Infinity" styleClass="f" />
         <Button fx:id="filterButton" contentDisplay="CENTER" mnemonicParsing="false" onAction="#filterClicked" styleClass="filters" StackPane.alignment="TOP_LEFT">
            <graphic>
               <Region>
                  <styleClass>
                     <String fx:value="icon-filter" />
                     <String fx:value="icon" />
                  </styleClass>
               </Region>
            </graphic>
            <StackPane.margin>
               <Insets left="10.0" top="90.0" />
            </StackPane.margin>
         </Button>
         <VBox fx:id="filterBox" maxHeight="200.0" maxWidth="160.0" minHeight="200.0" minWidth="160.0" prefHeight="100.0" prefWidth="100.0" styleClass="filterTab" stylesheets="@../css/icons.css" visible="false" StackPane.alignment="TOP_LEFT">
            <children>
               <Button fx:id="appleButton" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#appleButtonClicked" styleClass="sideBar-button" text="  Apple">
                  <graphic>
                     <Region>
                        <styleClass>
                           <String fx:value="icon" />
                           <String fx:value="icon-apple" />
                        </styleClass>
                     </Region>
                  </graphic></Button>
               <Button fx:id="pearButton" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#pearButtonClicked" styleClass="sideBar-button" text="  Pear">
                  <graphic>
                     <Region>
                        <styleClass>
                           <String fx:value="icon" />
                           <String fx:value="icon-pear" />
                        </styleClass>
                     </Region>
                  </graphic></Button>
               <Button fx:id="cherryButton" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cherryButtonClicked" styleClass="sideBar-button" text="  Cherry">
                  <graphic>
                     <Region>
                        <styleClass>
                           <String fx:value="icon" />
                           <String fx:value="icon-cherry" />
                        </styleClass>
                     </Region>
                  </graphic>
               </Button>
               <Button fx:id="peachButton" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#peachButtonClicked" styleClass="sideBar-button" text="  Peach">
                  <graphic>
                     <Region>
                        <styleClass>
                           <String fx:value="icon" />
                           <String fx:value="icon-peach" />
                        </styleClass>
                     </Region>
                  </graphic></Button>
               <Button fx:id="apricotButton" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#apricotButtonClicked" styleClass="sideBar-button" text="  Apricot">
                  <graphic>
                     <Region>
                        <styleClass>
                           <String fx:value="icon" />
                           <String fx:value="icon-apricot" />
                        </styleClass>
                     </Region>
                  </graphic>
               </Button>
            </children>
            <StackPane.margin>
               <Insets left="10.0" top="122.0" />
            </StackPane.margin>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
         </VBox>
      </StackPane>
   </center>
   <stylesheets>
      <URL value="@../css/styles.css" />
      <URL value="@../css/icons.css" />
   </stylesheets>
</BorderPane>
