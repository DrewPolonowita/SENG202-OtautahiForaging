<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.MapController">
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <WebView fx:id="webView" maxHeight="Infinity" maxWidth="Infinity" styleClass="f" />
         <Button fx:id="filterButton" contentDisplay="CENTER" mnemonicParsing="false" onAction="#filterClicked" styleClass="filters" StackPane.alignment="TOP_LEFT">
            <graphic>
               <Region>
                  <styleClass>
                     <String fx:value="icon-filter" />
                     <String fx:value="icon" />
                  </styleClass>
               </Region>
            </graphic>
            <StackPane.margin>
               <Insets left="10.0" top="25.0" />
            </StackPane.margin>
         </Button>
         <VBox fx:id="filterBox" maxHeight="-Infinity" maxWidth="160.0" minWidth="160.0" prefWidth="100.0" styleClass="filterTab" stylesheets="@../css/icons.css" visible="false" StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
               <Insets left="10.0" top="65.0" />
            </StackPane.margin>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="8.0" />
            </padding>
         </VBox>
      </StackPane>
   </center>
   <stylesheets>
      <URL value="@../css/styles.css" />
      <URL value="@../css/icons.css" />
   </stylesheets>
</BorderPane>
