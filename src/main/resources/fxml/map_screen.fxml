                           <String fx:value="icon" />
                           <String fx:value="icon-journal" />
                        </styleClass>
                     </Region>
                  </graphic>
               </Button>
               <Button alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sideBar-button" text="  Peach">
