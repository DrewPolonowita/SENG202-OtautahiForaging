<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.MapController">
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <WebView fx:id="webView" maxHeight="Infinity" maxWidth="Infinity" styleClass="f" />
         <Button contentDisplay="CENTER" mnemonicParsing="false" StackPane.alignment="TOP_LEFT">
            <graphic>
               <Region>
                  <styleClass>
                     <String fx:value="icon-filter" />
                     <String fx:value="icon" />
                  </styleClass>
               </Region>
            </graphic>
            <StackPane.margin>
               <Insets left="10.0" top="90.0" />
            </StackPane.margin>
            <stylesheets>
               <URL value="@../css/styles.css" />
               <URL value="@../css/icons.css" />
            </stylesheets>
            <styleClass>
               <String fx:value="filters" />
               <String fx:value="sideBar-button" />
            </styleClass>
         </Button>
      </StackPane>
   </center>
</BorderPane>
