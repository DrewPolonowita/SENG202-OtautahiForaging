<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox styleClass="note-card" spacing="16" alignment="CENTER" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.AddNoteController">
    <HBox alignment="TOP_RIGHT">
        <padding>
            <Insets top="10" right="10" bottom="0" left="10"/>
        </padding>
        <Button maxHeight="26" maxWidth="26" minHeight="26" minWidth="26" mnemonicParsing="false" onAction="#handleClose" prefHeight="26" prefWidth="26" styleClass="sideBar-button">
            <graphic>
                <Region>
                    <styleClass>
                        <String fx:value="icon-close" />
                        <String fx:value="icon" />
                    </styleClass>
                </Region>
            </graphic>
        </Button>
    </HBox>

    <VBox spacing="6" alignment="CENTER">
        <padding>
            <Insets top="0" right="10" bottom="0" left="10"/>
        </padding>
        <Label fx:id="commonNameDisplay" styleClass="note-card-title"/>
    </VBox>

    <VBox spacing="6" alignment="CENTER">
        <padding>
            <Insets top="0" right="10" bottom="0" left="10"/>
        </padding>
        <Label text="FIELD NOTES" styleClass="note-card-subtitle" />
        <TextArea fx:id="fieldNotesArea" styleClass="text-area" promptText="Describe the tree you saw..."/>
    </VBox>

    <VBox spacing="10" alignment="CENTER">
        <padding>
            <Insets top="0" right="10" bottom="0" left="10"/>
        </padding>
        <Label text="PHOTOGRAPH" styleClass="note-card-subtitle"/>
        <VBox fx:id="uploadZone" styleClass="upload-zone" alignment="CENTER" spacing="8" minHeight="130" maxWidth="Infinity" onMouseClicked="#handleSelectedPhoto">
            <Label fx:id="uploadHint" text="Click to upload a photo" styleClass="upload-hint"/>
        </VBox>
        <Button text="Remove photo" styleClass="remove-photo-button" onAction="#handleDeletePhoto"/>
    </VBox>

    <Button fx:id="recordButton" text="Record Observation" styleClass="record-button" onAction="#handleRecord" maxWidth="Infinity">
        <padding>
            <Insets top="0" right="10" bottom="0" left="10"/>
        </padding>
    </Button>
</VBox>
