<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox styleClass="note-card" spacing="16" alignment="CENTER" style="-fx-padding: 5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.AddNoteController">
    <HBox alignment="CENTER_LEFT">
        <Button text="←" fx:id="backButton" styleClass="close-button" onAction="#handleGoBack"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="✕" styleClass="close-button" onAction="#handleClose"/>
    </HBox>

    <VBox spacing="6" alignment="CENTER">
        <padding>
            <Insets top="0" right="10" bottom="0" left="10"/>
        </padding>
        <Label fx:id="commonNameDisplay" styleClass="note-card-title"/>
    </VBox>

    <VBox spacing="6" alignment="CENTER">
        <padding>
            <Insets top="0" right="10" bottom="0" left="10"/>
        </padding>
        <Label text="FIELD NOTES" styleClass="note-card-subtitle" />
        <TextArea fx:id="fieldNotesArea" styleClass="text-area" promptText="Describe the tree you saw..."/>
    </VBox>

    <VBox spacing="10" alignment="CENTER">
        <padding>
            <Insets top="0" right="10" bottom="0" left="10"/>
        </padding>
        <Label text="PHOTOGRAPH" styleClass="note-card-subtitle"/>
        <VBox fx:id="uploadZone" styleClass="upload-zone" alignment="CENTER" spacing="8" minHeight="130" maxWidth="Infinity" onMouseClicked="#handleSelectedPhoto">
            <Label fx:id="uploadHint" text="Click to upload a photo" styleClass="upload-hint"/>
        </VBox>
        <Button text="Remove photo" styleClass="remove-photo-button" onAction="#handleDeletePhoto"/>
    </VBox>

    <Button fx:id="recordButton" text="Record Observation" styleClass="record-button" onAction="#handleRecord" maxWidth="Infinity">
        <padding>
            <Insets top="0" right="10" bottom="0" left="10"/>
        </padding>
    </Button>
</VBox>
