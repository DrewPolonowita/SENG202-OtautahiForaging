<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.layout.Region?>
<?import java.lang.String?>
<BorderPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.TableViewController">
   <center>
      <TableView fx:id="treeTableView" prefHeight="200.0" prefWidth="518.0" style="-fx-text-background-color: black;" styleClass="filterTab" BorderPane.alignment="CENTER" />
   </center>
   <left>
      <VBox prefHeight="400.0" prefWidth="62.0" styleClass="sideBar">
         <Button fx:id="filterButton" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onFilterClicked" styleClass="filters">
            <graphic>
               <Region>
                  <styleClass>
                     <String fx:value="icon-filter" />
                     <String fx:value="icon" />
                  </styleClass>
               </Region>
            </graphic>
         </Button>
         <HBox fx:id="filterActions"
               spacing="5.0"
               visible="false"
               managed="false"
               StackPane.alignment="TOP_LEFT">

            <StackPane.margin>
               <Insets left="47.0" top="25.0" />
            </StackPane.margin>

            <Button fx:id="deselectAllButton"
                    contentDisplay="CENTER"
                    mnemonicParsing="false"
                    onAction="#deselectAllFilters"
                    styleClass="filters">
               <graphic>
                  <Region>
                     <styleClass>
                        <String fx:value="icon-deselect-all" />
                        <String fx:value="icon" />
                     </styleClass>
                  </Region>
               </graphic>
            </Button>

            <Button fx:id="selectAllButton"
                    contentDisplay="CENTER"
                    mnemonicParsing="false"
                    onAction="#selectAllFilters"
                    styleClass="filters">
               <graphic>
                  <Region>
                     <styleClass>
                        <String fx:value="icon-select-all" />
                        <String fx:value="icon" />
                     </styleClass>
                  </Region>
               </graphic>
            </Button>

         </HBox>
         <VBox fx:id="filterList" maxHeight="-Infinity" maxWidth="160.0" minWidth="160.0" prefWidth="100.0" styleClass="filterTab" stylesheets="@../css/icons.css" visible="false">
         </VBox>
      </VBox>
   </left>
</BorderPane>
