<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="helpPopup" prefHeight="453.0" prefWidth="624.0" spacing="10" styleClass="guidelines-box" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.HelpPopupController">
   <children>
      <HBox alignment="TOP_RIGHT">
         <padding>
            <Insets right="10.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="exitPopupButton" maxHeight="26" maxWidth="26" minHeight="26" minWidth="26" mnemonicParsing="false" onAction="#exitPopUp" prefHeight="26" prefWidth="26" styleClass="sideBar-button">
               <graphic>
                  <Region>
                     <styleClass>
                        <String fx:value="icon-close" />
                        <String fx:value="icon" />
                     </styleClass>
                  </Region>
               </graphic>
            </Button>
         </children>
      </HBox>
      <Label styleClass="titleBarText" text="How to use Ōtautahi Foraging?" wrapText="true" BorderPane.alignment="CENTER" />
      <HBox prefHeight="14.0" prefWidth="600.0" spacing="20" styleClass="guidelines-textbox">
         <children>
            <Label fx:id="pageTextBox" alignment="CENTER_RIGHT" styleClass="settings-text" text="The Map Page" wrapText="true" />
         </children>
      </HBox>
      <ScrollPane fx:id="mapPageScrollPane" fitToWidth="true" hbarPolicy="NEVER" maxHeight="-Infinity" prefHeight="270.0" styleClass="help-scrollpane" visible="false">
         <content>
            <VBox prefWidth="600.0" styleClass="help-box">
               <children>
                  <HBox maxWidth="600.0" prefWidth="600.0">
                     <children>
                        <Label minHeight="-Infinity" alignment="TOP_LEFT" lineSpacing="1.0" maxWidth="590.0" prefWidth="600.0" styleClass="help-text" text="Use the map to locate trees based on the type of food grown on them.  Trees can be filtered using the filter button at the left of the screen. The following icons refer to filter, select all, and deselect all respectively. Buttons are highlighted with the theme colour when clicked." wrapText="true" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" layoutX="10.0" layoutY="28.0" prefHeight="32.0" prefWidth="32.0">
                     <children>
                        <Region prefWidth="0.0">
                           <styleClass>
                              <String fx:value="icon-filter" />
                              <String fx:value="icon" />
                           </styleClass>
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                           <padding>
                              <Insets bottom="5.0" top="5.0" />
                           </padding>
                        </Region>
                        <Region>
                           <styleClass>
                              <String fx:value="icon-select-all" />
                              <String fx:value="icon" />
                           </styleClass>
                           <HBox.margin>
                              <Insets left="25.0" />
                           </HBox.margin>
                           <padding>
                              <Insets bottom="5.0" top="5.0" />
                           </padding>
                        </Region>
                        <Region>
                           <styleClass>
                              <String fx:value="icon-deselect-all" />
                              <String fx:value="icon" />
                           </styleClass>
                           <HBox.margin>
                              <Insets left="25.0" />
                           </HBox.margin>
                           <padding>
                              <Insets bottom="5.0" top="5.0" />
                           </padding>
                        </Region>
                     </children>
                  </HBox>
                  <HBox maxWidth="-Infinity" minWidth="550.0" prefWidth="590.0">
                     <children>
                        <Label minHeight="-Infinity" alignment="TOP_LEFT" lineSpacing="1.0" maxWidth="590.0" prefWidth="600.0" styleClass="help-text" text="Clusters of trees are grouped together based on what kind of food is grown on them. The colour of the cluster matches the main colours on the marker for a given food and the number corresponds with the number of trees. Click on a cluster to see the markers inside." wrapText="true" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="100.0">
                     <children>
                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" scaleX="0.5" scaleY="0.5" scaleZ="0.5">
                           <image>
                              <Image url="@../images/pins/applePin.png" />
                           </image>
                        </ImageView>
                        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="10.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" scaleX="0.5" scaleY="0.5" scaleZ="0.5">
                           <image>
                              <Image url="@../images/pins/apricotPin.png" />
                           </image>
                        </ImageView>
                        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="160.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" scaleX="0.5" scaleY="0.5" scaleZ="0.5">
                           <image>
                              <Image url="@../images/pins/peachPin.png" />
                           </image>
                        </ImageView>
                     </children>
                  </HBox>
                  <HBox prefHeight="61.0" prefWidth="600.0">
                     <children>
                        <Label alignment="CENTER" lineSpacing="10.0" prefHeight="137.0" prefWidth="200.0" styleClass="help-text" text="Apple" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets left="100.0" />
                           </padding>
                        </Label>
                        <Label alignment="CENTER" contentDisplay="CENTER" lineSpacing="10.0" prefHeight="137.0" prefWidth="200.0" styleClass="help-text" text="Apricot" textAlignment="CENTER" wrapText="true" />
                        <Label contentDisplay="CENTER" lineSpacing="10.0" prefHeight="137.0" prefWidth="200.0" styleClass="help-text" text="Peach" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets left="35.0" />
                           </padding>
                        </Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="100.0">
                     <children>
                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" scaleX="0.5" scaleY="0.5" scaleZ="0.5">
                           <image>
                              <Image url="@../images/pins/pearPin.png" />
                           </image>
                        </ImageView>
                        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="10.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" scaleX="0.5" scaleY="0.5" scaleZ="0.5">
                           <image>
                              <Image url="@../images/pins/strawberryPin.png" />
                           </image>
                        </ImageView>
                        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="160.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" scaleX="0.5" scaleY="0.5" scaleZ="0.5">
                           <image>
                              <Image url="@../images/pins/walnutPin.png" />
                           </image>
                        </ImageView>
                     </children>
                  </HBox>
                  <HBox prefHeight="61.0" prefWidth="600.0">
                     <children>
                        <Label alignment="CENTER" lineSpacing="10.0" prefHeight="137.0" prefWidth="200.0" styleClass="generic-text" text="Pear" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets left="100.0" />
                           </padding>
                        </Label>
                        <Label alignment="CENTER" contentDisplay="CENTER" lineSpacing="10.0" prefHeight="137.0" prefWidth="200.0" styleClass="generic-text" text="Strawberry" textAlignment="CENTER" wrapText="true" />
                        <Label contentDisplay="CENTER" lineSpacing="10.0" prefHeight="137.0" prefWidth="200.0" styleClass="generic-text" text="Walnut" textAlignment="CENTER" wrapText="true">
                           <padding>
                              <Insets left="35.0" />
                           </padding>
                        </Label>
                     </children>
                  </HBox>
                  <HBox maxWidth="-Infinity" minWidth="550.0" prefWidth="590.0">
                     <children>
                        <Label minHeight="-Infinity" alignment="TOP_LEFT" lineSpacing="1.0" maxWidth="590.0" prefWidth="600.0" styleClass="help-text" text="Click on a marker for more information on a tree or to add a note to it. Notes can be found in the journal page." wrapText="true" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <ScrollPane fx:id="journalPageScrollPane" fitToWidth="true" hbarPolicy="NEVER" maxHeight="-Infinity" prefHeight="270.0" style="-fx-border-color: transparent;">
         <content>
            <VBox styleClass="help-box">
               <children>
                  <HBox maxWidth="600.0" prefWidth="600.0">
                     <children>
                        <Label minHeight="-Infinity" alignment="TOP_LEFT" lineSpacing="1.0" maxWidth="590.0" prefWidth="600.0" styleClass="help-text" text="Journals are made through the map page by clicking on a marker and then using the add to journal button. Saved notes are stored here. To have the option to view, edit, delete a note or view the associated tree on the map, click on the relevant note. Notes can be filtered using the sort by button at the top left." wrapText="true" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <ScrollPane fx:id="recipePageScrollPane" fitToWidth="true" hbarPolicy="NEVER" maxHeight="-Infinity" prefHeight="270.0" style="-fx-border-color: transparent;">
         <content>
            <VBox styleClass="help-box">
               <children>
                  <HBox maxWidth="600.0" prefWidth="600.0">
                     <children>
                        <Label minHeight="-Infinity" alignment="TOP_LEFT" lineSpacing="1.0" maxWidth="590.0" prefWidth="600.0" styleClass="help-text" text="Select a food from the filter to get relevant recipes. Click on a recipe card for the recipe and it's associated nutritional information. Filters selected on the map page will automatically appear on the recipe page and vice versa, so you can easily forage with a goal in mind." wrapText="true" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
