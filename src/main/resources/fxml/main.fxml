<BorderPane prefHeight="1080.0" prefWidth="200.0" styleClass="root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.MainController">
   <left>
