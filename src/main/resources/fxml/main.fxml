               </Label>
               <Region maxWidth="70.0" minHeight="48.0" prefHeight="48.0" prefWidth="42.0" styleClass="icon-logo" stylesheets="@../css/icons.css" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="TOP">
