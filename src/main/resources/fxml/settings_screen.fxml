<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.SettingsController">
   <center>
      <VBox prefHeight="400.0" prefWidth="400.0" spacing="10">
         <Label styleClass="titleBarText" text="SETTINGS" BorderPane.alignment="CENTER" />
         <Label styleClass="settings-text" text="Appearance" />
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label styleClass="generic-text" text="Dark Mode" />
            <ToggleButton fx:id="darkModeToggle" onAction="#onDarkModeToggle" styleClass="switch">
               <graphic>
                  <StackPane fx:id="switchTrack" alignment="CENTER_LEFT" styleClass="switch-track">
                     <children>
                        <Circle fx:id="switchCircle" radius="9" styleClass="switch-circle" translateX="2" />
                     </children>
                  </StackPane>
               </graphic>
            </ToggleButton>
         </HBox>
         <Label styleClass="settings-text" text="Accent Colour" />
         <ColorPicker fx:id="colorPicker" onAction="#changeThemeColour" />
         <Button fx:id="tableButton" alignment="TOP_LEFT" maxWidth="Infinity" onAction="#onTableButtonClicked" styleClass="sideBar-button" text="  View Table" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
            <graphic>
               <Region styleClass="icon, icon-table" />
            </graphic>
         </Button>
      </VBox>
   </center>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</BorderPane>
