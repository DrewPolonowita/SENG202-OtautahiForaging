<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="303.0" prefWidth="457.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.RecipeHighlightController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="recipeScrollPane" BorderPane.alignment="CENTER">
         <content>
            <Text fx:id="recipeNameText" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" />
         </content>
      </ScrollPane>
   </center>
   <top>
      <Button fx:id="closeButton" maxHeight="26.0" maxWidth="26.0" minHeight="26.0" minWidth="26.0" mnemonicParsing="false" onAction="#closeClicked" prefHeight="26.0" prefWidth="26.0" styleClass="sideBar-button" BorderPane.alignment="TOP_RIGHT">
         <graphic>
            <Region>
               <styleClass>
                  <String fx:value="icon-close" />
                  <String fx:value="icon" />
               </styleClass>
            </Region>
         </graphic>
      </Button>
   </top>
   <stylesheets>
      <URL value="@../css/styles.css" />
      <URL value="@../css/icons.css" />
   </stylesheets>
</BorderPane>
