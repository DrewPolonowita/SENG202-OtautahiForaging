<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.JournalController">
   <top>
      <MenuButton text="Sort by" fx:id="sortMenu" styleClass = "sort-journal">
         <BorderPane.margin>
            <Insets left="20.0" top="20.0"/>
         </BorderPane.margin>
         <items>
            <MenuItem text="Newest first" onAction="#handleSortNewest"/>
            <MenuItem text="Oldest first" onAction="#handleSortOldest"/>
            <MenuItem text="Alphabetical A-Z" onAction="#handleSortAlphabetical"/>
         </items>
      </MenuButton>
   </top>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="journalCardBaseArea" BorderPane.alignment="CENTER">
         <FlowPane fx:id="notesFlowPane" hgap="16" prefHeight="Infinity" prefWidth="Infinity" prefWrapLength="800" styleClass="journalCardBaseArea" vgap="16">
            <padding>
               <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
         </FlowPane>
      </ScrollPane>
   </center>
   <right>
      <VBox maxHeight="32.0" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" BorderPane.alignment="TOP_CENTER">
         <children>
            <HBox alignment="CENTER_RIGHT" maxHeight="32.0" maxWidth="32.0">
               <children>
                  <Button fx:id="HelpButton" contentDisplay="CENTER" mnemonicParsing="false" onAction="#helpButtonClicked" styleClass="filters">
                     <graphic>
                        <Region>
                           <styleClass>
                              <String fx:value="icon-help" />
                              <String fx:value="icon" />
                           </styleClass>
                        </Region>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Help" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets right="10.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>