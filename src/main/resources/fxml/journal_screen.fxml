<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.JournalController">
   <top>
      <MenuButton text="Sort by" fx:id="sortMenu" styleClass = "sort-journal">
         <items>
            <MenuItem text="Newest first" onAction="#handleSortNewest"/>
            <MenuItem text="Oldest first" onAction="#handleSortOldest"/>
            <MenuItem text="Alphabetical A-Z" onAction="#handleSortAlphabetical"/>
         </items>
      </MenuButton>
   </top>
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" BorderPane.alignment="CENTER" styleClass="journalCardBaseArea">
         <FlowPane fx:id="notesFlowPane" hgap="16" vgap="16" prefWrapLength="800" prefWidth="Infinity" prefHeight="Infinity" styleClass="journalCardBaseArea">
            <padding>
               <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
         </FlowPane>
      </ScrollPane>
   </center>
</BorderPane>