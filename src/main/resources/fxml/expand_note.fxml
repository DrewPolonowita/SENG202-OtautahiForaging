<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox styleClass="expand-note-root" prefWidth="800" xmlns="http://javafx.com/javafx/25.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="seng202.team4.gui.screens.ExpandNoteController">

    <StackPane>
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <StackPane fx:id="photoContainer" styleClass="photo-container" prefHeight="370">
            <ImageView fx:id="photoView" />
        </StackPane>
    </StackPane>

    <VBox styleClass="expand-note-body" spacing="10">
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="nameLabel" styleClass="expand-note-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="✕" styleClass="close-button" onAction="#handleClose" />
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="dateLabel" styleClass="expand-note-meta" />
            <Label text="•" styleClass="expand-note-meta" />
            <Label fx:id="timeLabel" styleClass="expand-note-meta" />
        </HBox>

        <Label fx:id="descriptionLabel" styleClass="expand-note-description" wrapText="true" />
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="View on Map" styleClass="edit-button" onAction="#handleViewMap" maxWidth="100" />
            <Button text="Edit Note" styleClass="edit-button" onAction="#handleEdit" maxWidth="100" />
            <Button text="Delete Note" styleClass="delete-button" onAction="#handleDelete" maxWidth="100" />
        </HBox>
    </VBox>

</VBox>