<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import java.lang.String?>

<StackPane stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="seng202.team4.gui.screens.RecipesController">
   <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="recipeCardBaseArea">
      <center>
         <ScrollPane fitToHeight="true" fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="961.0" prefWidth="1177.0" styleClass="recipeScrollPane">
            <content>
               <TilePane fx:id="recipeTilePane" hgap="20.0" vgap="20.0" prefTileWidth="300.0" prefTileHeight="260.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="recipeCardBaseArea">
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                  </padding>
               </TilePane>
            </content>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
         </ScrollPane>
      </center>
      <top>
         <Button mnemonicParsing="false" onAction="#appleSearch" text="Button" BorderPane.alignment="CENTER"/>
      </top>
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
      </padding>
   </BorderPane>
   <Button mnemonicParsing="false"
           onAction="#onFilterClicked"
           styleClass="filters"
           StackPane.alignment="TOP_LEFT">
      <graphic>
         <Region>
            <styleClass>
               <String fx:value="icon-filter"/>
               <String fx:value="icon"/>
            </styleClass>
         </Region>
      </graphic>
      <StackPane.margin>
         <Insets left="10.0" top="25.0"/>
      </StackPane.margin>
   </Button>

   <VBox fx:id="filterList"
         maxHeight="-Infinity"
         maxWidth="160.0"
         minWidth="160.0"
         prefWidth="160.0"
         styleClass="filterTab"
         stylesheets="@../css/icons.css"
         visible="false"
         StackPane.alignment="TOP_LEFT">

      <StackPane.margin>
         <Insets left="10.0" top="65.0"/>
      </StackPane.margin>

      <padding>
         <Insets bottom="10.0"
                 left="10.0"
                 right="10.0"
                 top="8.0"/>
      </padding>
   </VBox>
   <StackPane fx:id="attributionPane" alignment="BOTTOM_RIGHT" mouseTransparent="false" pickOnBounds="false">
      <padding>
         <Insets right="15.0" bottom="15.0"/>
      </padding>
   </StackPane>
</StackPane>